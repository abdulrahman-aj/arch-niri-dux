#!/usr/bin/env bash
# Per-user package migrations in name order (Omarchy shape).
#
# User scripts only: non-interactive, no sudo, no package transactions.
# Each script in /usr/lib/arch-niri-dux/migrations/*.sh runs once per
# account, in text order. A marker in
# ~/.local/state/arch-niri-dux/migrations/ records success; failures stop
# at the first script and leave it pending for the next login.
#
# Fresh accounts never execute: the package writes one marker per script
# into /etc/skel, so useradd -m copies a complete set. Add a migration
# only for state a package-owned file, dependency, default, or missing-file
# seed cannot express (see the migrations skill). Ship zero scripts until
# such a change is needed.
set -euo pipefail

scripts_dir=${ARCH_NIRI_DUX_MIGRATIONS_DIR:-/usr/lib/arch-niri-dux/migrations}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/arch-niri-dux/migrations
mkdir -p "$state_dir"

shopt -s nullglob
scripts=("$scripts_dir"/*.sh)
shopt -u nullglob

for script in ${scripts[@]+${scripts[@]}}; do
    name=${script##*/}
    if [[ ! $name =~ ^[0-9]{8}_[0-9]{2}_[a-z0-9][a-z0-9_-]*\.sh$ ]]; then
        echo "Invalid migration: $script (expected YYYYMMDD_NN_slug.sh)" >&2
        exit 1
    fi
    # A skel-copied marker means this account already has the change.
    [[ -e "$state_dir/$name" ]] && continue
    # Stdout and stderr reach the journal; never print secrets.
    if ! /bin/bash "$script"; then
        echo "Migration $name failed; it stays pending for the next login." >&2
        exit 1
    fi
    : >"$state_dir/$name"
done
