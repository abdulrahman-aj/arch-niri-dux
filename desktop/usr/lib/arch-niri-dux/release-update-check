#!/usr/bin/env python3
"""Dux release button visibility check.

Exits 0 (button visible) only when the configured package repositories offer
a newer arch-niri-dux release than the installed one. Any other case,
including offline machines and malformed databases, exits non-zero (hidden)
without output. The repository database is downloaded to a temporary directory
and never touches /var/lib/pacman.
"""

import os
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from pathlib import Path

PACKAGE = 'arch-niri-dux'
FALLBACK_DB_URL = 'https://abdulrahman-aj.github.io/arch-niri-dux/x86_64/arch-niri-dux.db'
PACMAN_CONF = Path('/etc/pacman.conf')
TIMEOUT = 15


def _expand_server(value):
    machine = os.uname().machine
    return value.replace('$arch', machine).replace('$repo', PACKAGE)


def repo_db_urls(conf=PACMAN_CONF):
    """Database URLs for the [arch-niri-dux] repository in pacman config.

    Verification fixtures swap pacman.conf to a file:// repository under a
    different name; when [arch-niri-dux] is absent, fall back to probing
    arch-niri-dux.db on every configured server so the same checker qualifies
    fixture repositories.
    """
    override = os.environ.get('ARCH_NIRI_DUX_DB_URL')
    if override:
        return [override]
    try:
        stack = [conf.read_text()]
    except OSError:
        return [FALLBACK_DB_URL]
    seen_includes = set()
    # Follow includes breadth-first; included files can define the repo too.
    pending = list(stack)
    configs = []
    while pending:
        text = pending.pop(0)
        configs.append(text)
        for line in text.splitlines():
            stripped = line.strip()
            if stripped.startswith('Include'):
                _, _, include = stripped.partition('=')
                include = include.strip()
                if include and include not in seen_includes:
                    seen_includes.add(include)
                    try:
                        pending.append(Path(include).read_text())
                    except OSError:
                        continue
    target = []
    every = []
    for text in configs:
        section = None
        for line in text.splitlines():
            stripped = line.split('#', 1)[0].strip()
            if not stripped:
                continue
            if stripped.startswith('[') and stripped.endswith(']'):
                section = stripped[1:-1].strip()
                continue
            if stripped.startswith('Server'):
                _, _, value = stripped.partition('=')
                value = value.strip().rstrip('/')
                if not value:
                    continue
                every.append(_expand_server(value) + f'/{PACKAGE}.db')
                if section == PACKAGE:
                    target.append(_expand_server(value) + f'/{PACKAGE}.db')
    if target:
        return target
    return every or [FALLBACK_DB_URL]


def installed_version():
    """Installed arch-niri-dux version, or None when unknown."""
    override = os.environ.get('ARCH_NIRI_DUX_INSTALLED_VERSION')
    if override:
        return override or None
    try:
        output = subprocess.check_output(['pacman', '-Q', PACKAGE], text=True, stderr=subprocess.DEVNULL).strip()
    except (OSError, subprocess.CalledProcessError):
        return None
    parts = output.split()
    if len(parts) != 2 or parts[0] != PACKAGE:
        return None
    return parts[1] or None


def candidate_version_from_db(db_path):
    """arch-niri-dux version recorded in a repository database file."""
    try:
        with tarfile.open(db_path) as archive:
            for member in archive.getmembers():
                if not member.isfile() or not member.name.endswith('/desc'):
                    continue
                handle = archive.extractfile(member)
                if handle is None:
                    continue
                name = version = None
                section = None
                for raw in handle.read().decode('utf-8', 'replace').splitlines():
                    line = raw.strip()
                    if line.startswith('%') and line.endswith('%'):
                        section = line.strip('%')
                        continue
                    if section == 'NAME' and line:
                        name = line
                    elif section == 'VERSION' and line:
                        version = line
                    if name is not None and version is not None:
                        break
                if name == PACKAGE and version:
                    return version
    except (OSError, tarfile.TarError, EOFError, ValueError):
        return None
    return None


def is_newer(installed, candidate):
    """Whether vercmp considers candidate newer than installed."""
    if not installed or not candidate:
        return False
    try:
        output = subprocess.check_output(['vercmp', installed, candidate], text=True, stderr=subprocess.DEVNULL).strip()
    except (OSError, subprocess.CalledProcessError):
        return False
    return output == '-1'


def _download(url, destination):
    try:
        request = urllib.request.Request(url, headers={'User-Agent': 'arch-niri-dux-release-check/1.0'})
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response, open(destination, 'wb') as output:
            output.write(response.read(8 << 20))
        return True
    except Exception:
        return False


def check(db_urls=None, installed=None):
    """Whether the button should show; silent, never raises."""
    try:
        current = installed if installed is not None else installed_version()
        if not current:
            return False
        urls = db_urls if db_urls is not None else repo_db_urls()
        with tempfile.TemporaryDirectory(prefix='release-update-check-') as directory:
            for url in urls:
                db_path = Path(directory) / 'repo.db'
                try:
                    db_path.unlink()
                except OSError:
                    pass
                if not _download(url, db_path):
                    continue
                candidate = candidate_version_from_db(db_path)
                if candidate is None:
                    continue
                return is_newer(current, candidate)
        return False
    except Exception:
        return False


def main():
    sys.exit(0 if check() else 1)


if __name__ == '__main__':
    main()
