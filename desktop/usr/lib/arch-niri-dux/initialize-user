#!/usr/bin/env bash
set -euo pipefail
[[ $EUID != 0 ]] || { echo 'Run user initialization as the desktop user.' >&2; exit 1; }

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}
data_dir=${XDG_DATA_HOME:-$HOME/.local/share}
defaults=/usr/share/arch-niri-dux
mkdir -p "$config_dir/niri/dms" "$data_dir/dbus-1/services"

# These files become user/Dux-owned state. Never replace existing files or links.
for name in colors layout alttab input; do
    file="$config_dir/niri/dms/$name.kdl"
    if [[ ! -e "$file" && ! -L "$file" ]]; then
        install -m 0644 "$defaults/niri/dms/$name.kdl" "$file"
    fi
done
if [[ ! -e "$config_dir/niri/dms/binds.kdl" && ! -L "$config_dir/niri/dms/binds.kdl" ]]; then
    printf 'binds {}\n' >"$config_dir/niri/dms/binds.kdl"
fi
if [[ ! -e "$config_dir/niri/config.kdl" && ! -L "$config_dir/niri/config.kdl" ]]; then
    install -m 0644 "$defaults/niri-user.kdl" "$config_dir/niri/config.kdl"
fi
if [[ ! -e "$config_dir/niri/overrides.kdl" && ! -L "$config_dir/niri/overrides.kdl" ]]; then
    install -m 0644 "$defaults/niri/overrides.kdl" "$config_dir/niri/overrides.kdl"
fi
# Dux's terminal picker reads a per-user list. Factory MIME defaults are inherited.
if [[ ! -e "$config_dir/xdg-terminals.list" && ! -L "$config_dir/xdg-terminals.list" ]]; then
    install -m 0644 /etc/xdg/xdg-terminals.list "$config_dir/xdg-terminals.list"
fi

session="$state_dir/dms/session.json"
if [[ ! -e "$session" && ! -L "$session" ]]; then
    mkdir -p "$(dirname "$session")"
    printf '%s\n' '{"configVersion": 7, "materialWallpapers": {"": {"shared": {"preset": "bloom", "seed": "#d0bcff"}}}}' >"$session"
fi

# A user service directory has precedence over Nautilus's system activation file.
file_manager="$data_dir/dbus-1/services/dev.duxlabs.files.FileManager1.service"
if [[ ! -e "$file_manager" && ! -L "$file_manager" ]]; then
    ln -s /usr/share/dbus-1/services/dev.duxlabs.files.FileManager1.service "$file_manager"
fi
