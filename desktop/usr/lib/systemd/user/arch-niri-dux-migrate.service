[Unit]
# Run after the enabling target without making that target wait for this queue.
DefaultDependencies=no
# Successive package transactions and failure recovery can arrive in a burst.
StartLimitIntervalSec=0
Conflicts=shutdown.target
Before=shutdown.target
Description=Apply Arch Niri Dux user migrations
After=graphical-session.target dms.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/arch-niri-dux-migrate run
TimeoutStartSec=infinity

[Install]
WantedBy=graphical-session.target
