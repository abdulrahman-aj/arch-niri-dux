#!/usr/bin/env bash
set -euo pipefail
user=${1:?Usage: configure-desktop USERNAME}
user_home=$(getent passwd "$user" | cut -d: -f6)
[[ -d "$user_home" && "$user_home" != / ]] || exit 1
user_group=$(id -gn "$user")
install -d -o "$user" -g "$user_group" "$user_home/.config/niri" \
    "$user_home/.config/environment.d" "$user_home/.local/share/dbus-1/services"
niri_defaults=/usr/share/arch-niri-dux/niri
install -d -o "$user" -g "$user_group" "$user_home/.config/niri/dms"
for name in colors layout alttab input; do
    file="$user_home/.config/niri/dms/$name.kdl"
    if [[ ! -e "$file" && ! -L "$file" ]]; then
        install -m 0644 "$niri_defaults/dms/$name.kdl" "$file"
    fi
done
if [[ ! -e "$user_home/.config/niri/dms/binds.kdl" && ! -L "$user_home/.config/niri/dms/binds.kdl" ]]; then
    printf 'binds {}\n' > "$user_home/.config/niri/dms/binds.kdl"
fi
if [[ ! -e "$user_home/.config/niri/config.kdl" && ! -L "$user_home/.config/niri/config.kdl" ]]; then
    install -m 0644 /usr/share/arch-niri-dux/niri-user.kdl "$user_home/.config/niri/config.kdl"
fi
# Use upstream's GTK passthrough for Qt, without another AUR platform plugin.
install -m 0644 /usr/share/arch-niri-dux/environment.conf "$user_home/.config/environment.d/90-dux.conf"
# Dux's terminal picker reads the per-user list rather than resolving system defaults.
if [[ ! -e "$user_home/.config/xdg-terminals.list" ]]; then
    install -m 0644 -o "$user" -g "$user_group" /etc/xdg/xdg-terminals.list \
        "$user_home/.config/xdg-terminals.list"
fi
cat >"$user_home/.config/mimeapps.list" <<'EOF'
[Default Applications]
inode/directory=dev.duxlabs.files.desktop
application/pdf=org.gnome.Papers.desktop
EOF
# Seed Dux's first-session wallpaper to the upstream "bloom" material preset.
# Dux owns the preset assets; an empty session would render its "dank" default.
# Never overwrite an existing choice: only create the state file when absent.
state_dir="$user_home/.local/state/dms"
state_file="$state_dir/session.json"
if [[ ! -e "$state_file" ]]; then
  install -d -o "$user" -g "$user_group" "$state_dir"
  cat >"$state_file" <<'EOF'
{"configVersion": 7, "materialWallpapers": {"": {"shared": {"preset": "bloom", "seed": "#d0bcff"}}}}
EOF
  chown "$user:$user_group" "$state_file"
  chmod 0644 "$state_file"
fi
# A user service directory has precedence over Nautilus's system activation file.
ln -sf /usr/share/dbus-1/services/dev.duxlabs.files.FileManager1.service \
    "$user_home/.local/share/dbus-1/services/dev.duxlabs.files.FileManager1.service"
chown -R "$user:$user_group" "$user_home/.config" "$user_home/.local"
systemctl --global enable dms.service dsearch.service dcal.service dfiles.service dux-application-themes.service
systemd-tmpfiles --create /usr/lib/tmpfiles.d/dms-greeter.conf
# Calendar credentials use the Secret portal; unlock its keyring at login.
cat >>/etc/pam.d/greetd <<'EOF'

auth optional pam_gnome_keyring.so
session optional pam_gnome_keyring.so auto_start
EOF
systemctl enable greetd NetworkManager bluetooth power-profiles-daemon
