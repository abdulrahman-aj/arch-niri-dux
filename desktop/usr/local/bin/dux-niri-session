#!/bin/sh
# arch-niri-dux Niri session entry for greetd.
#
# greetd launches the compositor directly: no login shell runs, and the
# compositor is not a systemd user service, so neither /etc/profile.d nor
# ~/.config/environment.d can reach the environment Niri spawns inherit.
# (Niri `spawn` does no shell expansion and resolves via the compositor's own
# PATH.) Append ~/.local/bin here, preserving the inherited PATH so system
# and Nix entries keep precedence, then exec the real compositor so every
# spawn (e.g. "zed") resolves.
set -eu
if [ -n "${HOME-}" ]; then
    case ":${PATH-}:" in
        *":${HOME}/.local/bin:"*) ;;
        *) PATH="${PATH:+$PATH:}${HOME}/.local/bin" ;;
    esac
    export PATH
fi
exec niri "$@"
