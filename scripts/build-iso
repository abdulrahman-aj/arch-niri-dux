#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
state=${BUILD_STATE:-${XDG_CACHE_HOME:-$HOME/.cache}/arch-niri-dux-build}
mkdir -p "$state" out
state=$(realpath "$state")
exec 9>"$state/build.lock"
flock -n 9 || { echo 'Another ISO build is using this state directory' >&2; exit 1; }
mode=${1:-release}
[[ $mode == release || $mode == development ]] || { echo 'Expected release or development mode' >&2; exit 1; }
printf '%s\n' "$mode" >"$state/integration-mode"
# Linked worktrees point outside the guest's source mount. Resolve Git here.
git log -1 --format=%ct >"$state/integration-epoch"
[[ -s keys/integration-signing.gpg && -s keys/integration-signing.fingerprint ]] || {
    echo 'Provision the integration public signing identity before building an ISO.' >&2
    exit 1
}
[[ -r /dev/kvm && -w /dev/kvm ]] || { echo 'KVM is required' >&2; exit 1; }
for tool in qemu-system-x86_64 qemu-img bsdtar curl gpgv python3; do
    command -v "$tool" >/dev/null || { echo "Missing required tool: $tool" >&2; exit 1; }
done
./scripts/build-fetch-bootstrap "$state"
bsdtar -xf "$state/archlinux.iso" -C "$state" arch/boot/x86_64/vmlinuz-linux arch/boot/x86_64/initramfs-linux.img
# The guest runs only the checked-in builder; no root access on the host.
if [[ ! -e "$state/builder.qcow2" ]]; then qemu-img create -f qcow2 "$state/builder.qcow2" 40G; fi
cp keys/trusted-packagers.gpg "$state/trusted-packagers.gpg"
host_cache=/var/cache/pacman/pkg
if [[ ! -d "$host_cache" ]]; then
    host_cache=$state/empty-cache
    mkdir -p "$host_cache"
fi
cat > "$state/startup.sh" <<'START'
#!/bin/bash
set -euxo pipefail
mkdir -p /source /state /cache
mount -t 9p -o trans=virtio,version=9p2000.L source /source
mount -t 9p -o trans=virtio,version=9p2000.L state /state
mount -t 9p -o trans=virtio,version=9p2000.L cache /cache
bash /source/scripts/build-guest > /state/guest-build.log 2>&1
printf 'success\n' > /state/result
poweroff -f
START
chmod +x "$state/startup.sh"
rm -f "$state/result"
# archiso's script= hook downloads and executes startup.sh via the host-only
# user network. The HTTP server is bound to loopback and serves only build state.
python3 -m http.server 18765 --bind 127.0.0.1 --directory "$state" > "$state/http.log" 2>&1 &
server=$!
trap 'kill "$server" 2>/dev/null || true' EXIT
qemu-system-x86_64 -enable-kvm -cpu host -m 8192 -smp 4 -display none -serial "file:$state/serial.log" \
 -kernel "$state/arch/boot/x86_64/vmlinuz-linux" -initrd "$state/arch/boot/x86_64/initramfs-linux.img" \
 -append 'archisobasedir=arch archisolabel=ARCH_202610 console=ttyS0 cow_spacesize=3G script=http://10.0.2.2:18765/startup.sh' \
 -drive "file=$state/archlinux.iso,media=cdrom,readonly=on" \
 -drive "file=$state/builder.qcow2,format=qcow2,if=virtio,discard=unmap" \
 -virtfs "local,path=$PWD,mount_tag=source,security_model=none" \
 -virtfs "local,path=$state,mount_tag=state,security_model=none" \
 -virtfs "local,path=$host_cache,mount_tag=cache,security_model=none,readonly=on" \
 -nic user,model=virtio-net-pci -no-reboot
[[ $(cat "$state/result" 2>/dev/null) == success ]] || { echo "Build failed; see $state/guest-build.log and serial.log" >&2; exit 1; }
sha256sum out/*.iso
