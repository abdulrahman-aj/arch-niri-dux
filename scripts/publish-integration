#!/usr/bin/env bash
set -euo pipefail
root=${1:?Usage: publish-integration ROOT PACKAGES HISTORY OUTPUT}
packages=${2:?}
history=${3:?}
output=${4:?}
tag=${GITHUB_REF_NAME:?}
commit=${GITHUB_SHA:?}
repository=${GITHUB_REPOSITORY:?}
[[ $repository == abdulrahman-aj/arch-niri-dux && $tag =~ ^v[0-9]+(\.[0-9]+)*-[0-9]+(\.[0-9]+)*$ ]]
git -c safe.directory="$root" -C "$root" merge-base --is-ancestor "$commit" origin/main

temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
releases=$temporary/releases.json
# Fetch successfully before interpreting an empty release list as a first release.
gh api --paginate --slurp "repos/$repository/releases" >"$releases"
current=$(jq --arg tag "$tag" '[.[][] | select(.tag_name == $tag)][0] // null' "$releases")
published=false
if [[ $current != null ]]; then
    # Separate assignments let errexit fail on malformed release JSON instead
    # of silently treating it as a non-draft or a mismatched draft.
    is_draft=$(jq -r '.isDraft // .draft' <<<"$current")
    if [[ $is_draft == true ]]; then
        # An interrupted upload has not been advertised to pacman clients yet.
        draft_body=$(jq -r '.body' <<<"$current")
        [[ $draft_body == "Signed integration packages for $commit." ]]
        draft_target=$(jq -r '.target_commitish' <<<"$current")
        [[ $draft_target == "$commit" ]]
        gh release delete "$tag" --repo "$repository" --yes
    else
        # Reuse immutable published bytes when retrying a failed Pages deployment.
        packages=$temporary/packages
        python "$root/scripts/integration_release.py" fetch "$root" "$packages"
        published=true
    fi
fi
mkdir -p "$history"
python "$root/scripts/integration_release.py" history-tags "$root" "$releases" --tag "$tag" >"$temporary/history-tags"
while IFS= read -r previous; do
    gh release download "$previous" --repo "$repository" --dir "$history" --skip-existing \
        --pattern 'arch-niri-dux-*.pkg.tar.zst' --pattern 'arch-niri-dux-*.pkg.tar.zst.sig' \
        --pattern 'dux-*.pkg.tar.zst' --pattern 'dux-*.pkg.tar.zst.sig'
done <"$temporary/history-tags"
python "$root/scripts/integration_release.py" publish "$root" "$packages" "$history" "$output" \
    --tag "$tag" --commit "$commit"
if [[ $published == false ]]; then
    assets=()
    jq -er '.packages[].filename, .apps[].filename, .omarchy[].filename' "$output/integration.manifest.json" >"$temporary/assets"
    while IFS= read -r name; do
        assets+=("$output/$name" "$output/$name.sig")
    done <"$temporary/assets"
    assets+=("$output/integration.manifest.json" "$output/integration.manifest.json.sig"
        "$output/integration.tar" "$output/integration.PKGBUILD")
    gh release create "$tag" --repo "$repository" --draft --target "$commit" \
        --title "$tag" --notes "Signed integration packages for $commit." "${assets[@]}"
    gh release edit "$tag" --repo "$repository" --draft=false
fi
