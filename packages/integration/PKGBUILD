# scripts/build-integration.py supplies the local source archive and its checksum.
pkgbase=arch-niri-dux
pkgname=(arch-niri-dux arch-niri-dux-baseline)
pkgver=0.2.0
pkgrel=2
pkgdesc='Arch Niri Dux desktop integration'
arch=(any)
url='https://github.com/abdulrahman-aj/arch-niri-dux'
# No top-level project license has been declared. Preserve the vendored Dux notice.
source=(integration.tar)

prepare() {
    local defaults="$srcdir/desktop/usr/share/arch-niri-dux/niri"
    # Keep pinned upstream files intact; user includes resolve in the user's home.
    sed '/^include /d' "$defaults/config.kdl" >"$defaults/defaults.kdl"
    printf '\ninclude "binds.kdl"\ninclude "../session.kdl"\n' >>"$defaults/defaults.kdl"
    sed 's/{{TERMINAL_COMMAND}}/xdg-terminal-exec/g' "$defaults/dms/binds.kdl" >"$defaults/binds.kdl"
}

package_arch-niri-dux() {
    depends=(bash systemd pacman niri 'dux-shell>=2.1.0' dux-greeter-bin dux-search-bin dux-calendar-bin
             dux-files-bin greetd gnome-keyring matugen adw-gtk-theme gtk3
             xdg-desktop-portal-gnome xdg-desktop-portal-gtk xdg-terminal-exec xdg-utils)
    backup=(etc/fonts/conf.d/50-arabic.conf etc/greetd/dux.toml
            etc/profile.d/dux-localbin.sh etc/profile.d/dux-editor.sh
            etc/pacman.d/arch-niri-dux.conf
            etc/systemd/logind.conf.d/30-lid.conf
            etc/xdg/mimeapps.list etc/xdg/xdg-desktop-portal/niri-portals.conf
            etc/xdg/xdg-terminals.list)
    cp -a "$srcdir/desktop/etc" "$srcdir/desktop/usr" "$pkgdir/"
    chmod 0755 "$pkgdir/usr/lib/arch-niri-dux/initialize-user" \
        "$pkgdir/usr/lib/arch-niri-dux/initialize-application-themes"
    install -Dm644 "$srcdir/desktop/usr/share/arch-niri-dux/DUX-LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/DUX-LICENSE"
    # Originals remain pinned source inputs; sessions load the generated files.
    rm "$pkgdir/usr/share/arch-niri-dux/niri/config.kdl" \
        "$pkgdir/usr/share/arch-niri-dux/niri/dms/binds.kdl" \
        "$pkgdir/usr/share/arch-niri-dux/DUX-LICENSE"
}

package_arch-niri-dux-baseline() {
    pkgdesc='Maintained application and system baseline for Arch Niri Dux'
    depends=(arch-niri-dux)
    local line package
    while IFS= read -r line; do
        package=${line%%#*}
        # The reviewed list contains one package per line, without whitespace.
        [[ -z $package ]] || depends+=("$package")
    done <"$srcdir/packages.target"
}
