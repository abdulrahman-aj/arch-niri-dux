# scripts/package_build.py supplies the local source archive and its checksum.
pkgbase='arch-niri-dux'
pkgname=(arch-niri-dux arch-niri-dux-baseline)
pkgver=0.3.2
pkgrel=1
pkgdesc='Arch Niri Dux desktop integration'
arch=(any)
url='https://github.com/abdulrahman-aj/arch-niri-dux'
# No top-level project license has been declared. Preserve the vendored Dux notice.
source=(integration.tar)

prepare() {
    local defaults="$srcdir/desktop/usr/share/arch-niri-dux/niri"
    # Keep pinned upstream files intact; user includes resolve in the user's home.
    sed '/^include /d' "$defaults/config.kdl" >"$defaults/defaults.kdl"
    printf '\ninclude "binds.kdl"\n' >>"$defaults/defaults.kdl"
    sed 's/{{TERMINAL_COMMAND}}/xdg-terminal-exec/g' "$defaults/dms/binds.kdl" >"$defaults/binds.kdl"
}

package_arch-niri-dux() {
    depends=(bash python systemd pacman niri 'dux-shell>=2.1.2' dux-greeter-bin dux-search-bin dux-calendar-bin
             dux-files-bin greetd gnome-keyring matugen adw-gtk-theme gtk3
             xdg-desktop-portal-gnome xdg-desktop-portal-gtk xdg-terminal-exec xdg-utils nftables)
    backup=(etc/snapper/configs/root etc/mkinitcpio.conf.d/arch-niri-dux.conf
            etc/fonts/conf.d/50-arabic.conf etc/fonts/conf.d/51-cjk.conf etc/greetd/dux.toml
            etc/profile.d/dux-localbin.sh etc/profile.d/dux-editor.sh
            etc/pacman.d/arch-niri-dux.conf
            etc/systemd/logind.conf.d/30-lid.conf
            etc/xdg/mimeapps.list etc/xdg/xdg-desktop-portal/niri-portals.conf
            etc/xdg/xdg-terminals.list)
    cp -a "$srcdir/desktop/etc" "$srcdir/desktop/usr" "$pkgdir/"
    # Dux Files answers org.freedesktop.FileManager1 ("Show in folder"); a link
    # tracks dux-files-bin instead of a copy that drifts. The user directory
    # wins over Nautilus's system file of the same name; dbus-broker logs one
    # expected duplicate-name line for the shadowed file.
    install -d "$pkgdir/etc/skel/.local/share/dbus-1/services"
    ln -s /usr/share/dfiles/org.freedesktop.FileManager1.service \
        "$pkgdir/etc/skel/.local/share/dbus-1/services/org.freedesktop.FileManager1.service"
    # The pinned DMS fragments are the source of truth; new homes seed from them.
    install -Dm644 "$srcdir/desktop/usr/share/arch-niri-dux/niri/dms/"{colors,layout,alttab,input}.kdl \
        -t "$pkgdir/etc/skel/.config/niri/dms/"
    install -d "$pkgdir/usr/lib/arch-niri-dux/migrations"
    # Fresh accounts never execute migrations: useradd -m copies these markers
    # as a complete set. None ship today; the loop stays for future scripts.
    install -d "$pkgdir/etc/skel/.local/state/arch-niri-dux/migrations"
    shopt -s nullglob
    for script in "$srcdir"/desktop/usr/lib/arch-niri-dux/migrations/*.sh; do
        : >"$pkgdir/etc/skel/.local/state/arch-niri-dux/migrations/${script##*/}"
    done
    shopt -u nullglob
    # Local firewall rules; the package ruleset includes *.nft from here.
    install -d "$pkgdir/etc/arch-niri-dux/firewall.d"
    chmod 0755 "$pkgdir/usr/bin/arch-niri-dux-migrate" \
        "$pkgdir/usr/bin/arch-niri-dux-keyring-recover"
    # Vendor wants apply to already-installed systems too; /etc can override.
    install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
    ln -s ../arch-niri-dux-migrate.service \
        "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/"
    chmod 0755 "$pkgdir/usr/lib/arch-niri-dux/initialize-application-themes" \
        "$pkgdir/usr/lib/arch-niri-dux/lid-close"
    install -Dm644 "$srcdir/desktop/usr/share/arch-niri-dux/DUX-LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/DUX-LICENSE"
    # Originals remain pinned source inputs; sessions load the generated files.
    rm "$pkgdir/usr/share/arch-niri-dux/niri/config.kdl" \
        "$pkgdir/usr/share/arch-niri-dux/niri/dms/binds.kdl" \
        "$pkgdir/usr/share/arch-niri-dux/DUX-LICENSE"
}

package_arch-niri-dux-baseline() {
    pkgdesc='Maintained application and system baseline for Arch Niri Dux'
    depends=(arch-niri-dux)
    local line package
    while IFS= read -r line; do
        package=${line%%#*}
        # The reviewed list contains one package per line, without whitespace.
        [[ -z $package ]] || depends+=("$package")
    done <"$srcdir/packages/packages.target"
}
